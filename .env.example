# Copy this file to .env and fill in your own values.
# .env is gitignored. Never put real credentials in this example file.

# The Gmail address that holds your Newsletters label
GMAIL_ADDRESS=you@gmail.com

# A Gmail App Password (16 characters), NOT your normal Gmail password.
# Create one at https://myaccount.google.com/apppasswords (needs 2-Step Verification on)
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# A free Gemini API key. Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
